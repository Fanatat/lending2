# Raw JSON feed with the latest HP100 sensor reading, published by the
# hp100-bot service (see ~/projects/hp100-live-feed/update_feed.py) to a
# public GitHub repo — not the sensor board itself, which only answers
# reliably on the VPS's own network. Default (see lib/hp100-live.ts)
# already points at that repo's raw.githubusercontent.com URL, which is
# HTTPS and CORS-friendly out of the box, so this only needs overriding
# if the feed repo ever moves.
NEXT_PUBLIC_HP100_FEED_URL=https://raw.githubusercontent.com/Fanatat/hp100-live-feed/master/latest.json
