# Endpoint the HP100 widget polls for the latest reading and its 24 h
# history: api.vanatat.ru/site/air → bridge on the home server → the
# board's own server. Default (see lib/hp100-live.ts) already points here;
# override only to test against a local mock. The endpoint answers with
# CORS only for the site's own origins, so a local build reaches it only
# through such a mock.
NEXT_PUBLIC_HP100_FEED_URL=https://api.vanatat.ru/site/air
